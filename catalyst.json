{
  "project": {
    "name": "ksp-crime-intelligence",
    "type": "webapp",
    "scope": "ksp"
  },
  "functions": {
    "source": "functions",
    "targets": [
      "health",
      "auth_context",
      "cases",
      "masters",
      "analytics",
      "network",
      "ai",
      "alerts",
      "reports",
      "admin",
      "ingest",
      "entities",
      "search",
      "offenders"
    ]
  },
  "api_gateway": {
    "base_path": "/api/v1",
    "auth": true,
    "cors": {
      "origins": [
        "http://localhost:3000",
        "http://localhost:8080",
        "https://ksp-clwavvcr.onslate.in"
      ]
    }
  },
  "apig": {
    "enabled": true,
    "rules": "catalyst-user-rules.json"
  }
}
